diff --git a/iso/overlay/configs/airootfs/usr/share/omarchy-iso/deck-form.sh b/iso/overlay/configs/airootfs/usr/share/omarchy-iso/deck-form.sh
index 1cfc535..de5acde 100755
--- a/iso/overlay/configs/airootfs/usr/share/omarchy-iso/deck-form.sh
+++ b/iso/overlay/configs/airootfs/usr/share/omarchy-iso/deck-form.sh
@@ -179,12 +179,56 @@ set -uo pipefail
 
 readonly DECK_FORM_PROG=deck-form
 
-deck_form_log()  { printf '[%s] %s\n' "$DECK_FORM_PROG" "$*" >&2; }
-deck_form_warn() { printf '[%s] WARNING: %s\n' "$DECK_FORM_PROG" "$*" >&2; }
+# DECK_FORM_LOG -- every deck_form_log/warn/die/abort call is echoed to stderr
+# (the visible tty, as before) AND appended here. Before this, a failure
+# during the pre-install form (drive detection, the early-stage handoff --
+# anything upstream of omarchy-install-dashboard, which is the only thing
+# that ever wrote a persistent record, in /var/log/omarchy-deck-install.json)
+# left nothing on disk: the tty text scrolled away the moment the wrapping
+# `.automated_script.sh` exited and dropped to a shell, so "no relevant
+# logs" was the correct, literal description of what a failed pre-install
+# form left behind. Overridable so the [U] suite (and anyone debugging by
+# hand) can point it elsewhere; falls back to /tmp if /var/log is not yet
+# writable (e.g. very early boot, before the overlay mount is live).
+readonly DECK_FORM_LOG_DEFAULT=/var/log/omarchy-deck-form.log
+deck_form_log_path() { printf '%s\n' "${DECK_FORM_LOG:-$DECK_FORM_LOG_DEFAULT}"; }
+
+deck_form_log_write() {
+  local path
+  path=$(deck_form_log_path)
+  if ! printf '[%s] %s\n' "$(date -u +%FT%TZ 2>/dev/null || echo '?')" "$*" >>"$path" 2>/dev/null; then
+    # /var/log unwritable this early: fall back once to /tmp so the record
+    # still exists somewhere, rather than silently dropping it.
+    printf '[%s] %s\n' "$(date -u +%FT%TZ 2>/dev/null || echo '?')" "$*" >>/tmp/omarchy-deck-form.log 2>/dev/null || true
+  fi
+}
+
+deck_form_log()  { printf '[%s] %s\n' "$DECK_FORM_PROG" "$*" >&2; deck_form_log_write "$*"; }
+deck_form_warn() { printf '[%s] WARNING: %s\n' "$DECK_FORM_PROG" "$*" >&2; deck_form_log_write "WARNING: $*"; }
 # Never exits (see SOURCE-SAFETY above) -- logs and returns 1. Callers that
 # need to stop must return themselves; this only stops itself from being
 # silent about why.
-deck_form_die()  { printf '[%s] ERROR: %s\n' "$DECK_FORM_PROG" "$*" >&2; return 1; }
+deck_form_die()  { printf '[%s] ERROR: %s\n' "$DECK_FORM_PROG" "$*" >&2; deck_form_log_write "ERROR: $*"; return 1; }
+
+# abort -- overrides upstream's own abort() (configs/airootfs/root/configurator,
+# see abort() there): draws the same on-screen message via the same `gum
+# style` calls, so nothing visible changes, but ALSO writes the reason to
+# DECK_FORM_LOG first. Same wrap technique this whole file already uses
+# (bash keeps the last definition of a name; this is sourced after
+# `configurator` defines its own abort, before any screen runs). Every
+# `abort "..."` call anywhere in the form or in this file's own S0/drive
+# code now leaves a line in the log even though the process exits 1 right
+# after -- which is the one thing upstream's abort could never do, because
+# it did not know this file, or this ISO's log path, existed.
+abort() {
+  local msg=${1:-Aborted installation}
+  deck_form_log_write "ABORT: $msg"
+  gum style "$msg"
+  echo
+  gum style "You can retry later by running: ./.automated_script.sh"
+  gum style --foreground 8 "Details: $(deck_form_log_path)"
+  exit 1
+}
 
