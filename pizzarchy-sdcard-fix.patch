   lsblk_tmp=$(mktemp) || { deck_form_die "mktemp failed"; return 1; }
   "$lsblk_bin" -dpno NAME,TYPE,RM,TRAN >"$lsblk_tmp" 2>/dev/null
+  # Diagnostic snapshot, written on every call (not just on failure): the
+  # drive screen is the one path in this file never run outside a
+  # fixture-fed unit test (docs/PROGRESS.md 5.50, "not exercised anywhere
+  # yet: the new screens themselves ... need the Deck"). If a real card
+  # reader enumerates slowly, reports unexpected lsblk columns, or gets
+  # excluded as the boot medium by mistake, this line is what makes that
+  # visible afterwards instead of only a transient message on screen.
+  deck_form_log_write "eligible-disks: exclude='$exclude_disk' lsblk-rows: $(tr '\n' ';' <"$lsblk_tmp")"
   deck_form_disk_list "$lsblk_tmp" "$exclude_disk"
   local rc=$?
   rm -f "$lsblk_tmp"
