diff --git a/configs/airootfs/usr/local/bin/omarchy-release-install-target b/configs/airootfs/usr/local/bin/omarchy-release-install-target
new file mode 100755
index 0000000..d9a2516
--- /dev/null
+++ b/configs/airootfs/usr/local/bin/omarchy-release-install-target
@@ -0,0 +1,124 @@
+#!/bin/bash
+#
+# Release the install target: deactivate every swap area under it,
+# recursively unmount it, and close the LUKS mappers that backed it. The one
+# source of truth for letting go of the target — the dashboard runs it
+# before offering the install medium's removal, and the orchestrator's
+# protected-failure cleanup runs it naming the mapper it may have opened.
+#
+# The swapoff comes first because active swap is an invisible holder: the
+# hibernation setup's swapon in the chroot lands in the shared kernel, fuser
+# then shows no process and the submounts unmount fine, yet the filesystem
+# reports busy until the swap is off. The mappers to close are read off the
+# mount table before the unmount empties it, and each one's device-mapper
+# UUID must carry the CRYPT- prefix before the close is attempted —
+# cryptsetup close happily removes a non-crypt mapping (LVM, linear), so the
+# sweep is bounded by that check, not by trust in a refusal. A busy crypt
+# mapper still fails its close, and the failure is reported.
+#
+# Extra arguments name mappers to close beyond what the mount table shows:
+# a failure between luksOpen and mount leaves a mapper open with nothing
+# mounted from it, which the table sweep cannot see.
+#
+# Idempotent: a target with nothing mounted and no mapper left open exits 0.
+# Exits nonzero when the tree stayed mounted (umount -R failed) or a crypt
+# mapper stayed open — either way the target is not fully let go, and the
+# dashboard's removal offer and immediate-reboot choice key on exactly that.
+
+set -uo pipefail
+
+# device-mapper's word on a mapper: prints its UUID and returns 0 when it
+# exists, 1 when it provably does not ("Device does not exist." is the
+# driver's own answer for ENXIO), and 2 when dmsetup could not answer at all
+# (control node unreachable, driver not responding) — the same rc 1 as a
+# missing mapper, told apart only by the message. The distinction matters
+# because 1 is the idempotent no-op and 2 must never pass for it: a mapper
+# that cannot be proven gone has to fail the release, and this exit status
+# is what stands between the user and pulling the medium.
+dm_err=$(mktemp)
+trap 'rm -f "$dm_err"' EXIT
+mapper_uuid() {
+  local uuid
+  if uuid=$(dmsetup info -c --noheadings -o uuid "$1" 2>"$dm_err"); then
+    printf '%s\n' "$uuid"
+    return 0
+  fi
+  grep -q "Device does not exist" "$dm_err" && return 1
+  echo "could not query mapper $1:" >&2
+  cat "$dm_err" >&2
+  return 2
+}
+
+target="${1:?usage: omarchy-release-install-target <mountpoint> [mapper ...]}"
+shift
+mappers=("$@")
+
+sync
+
+while IFS=' ' read -r swap_path _; do
+  [[ $swap_path == "$target"/* ]] && swapoff "$swap_path" 2>/dev/null
+done < <(tail -n +2 /proc/swaps 2>/dev/null)
+
+while IFS= read -r source; do
+  source="${source%%\[*}"
+  [[ $source == /dev/mapper/* ]] && mappers+=("${source#/dev/mapper/}")
+done < <(findmnt -rn -o SOURCE -R "$target" 2>/dev/null | sort -u)
+
+# On failure, name the holders on stderr: this is the diagnosis the swapfile
+# hunt needed once, done by the machine. fuser over lsof because the live
+# ISO ships psmisc and not lsof, and the holder table is what gets acted on.
+if mountpoint -q "$target"; then
+  if ! umount -R "$target"; then
+    {
+      echo "could not unmount $target; holders:"
+      fuser -vm "$target" 2>&1
+      echo "still mounted under it:"
+      findmnt -rn -R "$target"
+      echo "active swap:"
+      tail -n +2 /proc/swaps
+    } >&2
+    exit 1
+  fi
+fi
+
+# A mapper can be mounted outside the target tree too: the orchestrator
+# stage-mounts the same filesystem under /run/omarchy-install during some
+# phases, and a mid-phase failure can leave one behind — the close would
+# then fail silently on a device the target-tree unmount never saw.
+close_failed=0
+for mapper in "${mappers[@]}"; do
+  while IFS= read -r mountpoint; do
+    umount -R "$mountpoint" 2>/dev/null
+  done < <(findmnt -rn -o TARGET -S "/dev/mapper/$mapper" 2>/dev/null)
+  # Crypt mappings only — a foreign mapper under the target (or a stale name
+  # passed as an argument) is not ours to tear down, and cryptsetup would
+  # remove it without complaint. A missing mapper falls out here too, which
+  # keeps the no-op run silent the way idempotency wants — but only on the
+  # driver's word for missing: an unanswerable query fails the release.
+  uuid=$(mapper_uuid "$mapper")
+  case $? in
+    1) continue ;;
+    2) close_failed=1; continue ;;
+  esac
+  [[ $uuid == CRYPT-* ]] || continue
+  # dmsetup, not the /dev/mapper node, decides whether the close took: the
+  # node is udev's and lags in both directions — still there for a moment
+  # after a good close (which would withhold the offer on a machine that is
+  # fine), and never there at all when device-mapper runs with udev disabled
+  # (which would hide a mapper that really did stay open). Only its provable
+  # absence counts as closed; an unanswerable probe fails like a held one.
+  if ! cryptsetup close "$mapper" 2>/dev/null; then
+    mapper_uuid "$mapper" >/dev/null
+    if (( $? != 1 )); then
+      {
+        echo "could not close mapper $mapper; holders:"
+        fuser -vm "/dev/mapper/$mapper" 2>&1
+        dmsetup info "$mapper" 2>&1
+      } >&2
+      close_failed=1
+    fi
+  fi
+done
+
+sync
+exit $close_failed
diff --git a/configs/airootfs/usr/local/bin/omarchy-wait-root-image-verify b/configs/airootfs/usr/local/bin/omarchy-wait-root-image-verify
new file mode 100755
index 0000000..8122638
--- /dev/null
+++ b/configs/airootfs/usr/local/bin/omarchy-wait-root-image-verify
@@ -0,0 +1,151 @@
+#!/bin/bash
+# Single source of truth for validating the root image on the install medium
+# before anything formats a disk.
+#
+# The root image is streamed from the boot medium (copytoram is off), so a bad
+# medium must be caught before the full-disk orchestrator hands off to
+# archinstall *and* before the free-space configurator partitions the target.
+# omarchy-root-image-verify.service hashes the image in the background from boot
+# (idle-class, so it yields to the live system under the boot-medium BFQ rule);
+# this collects that verdict, waiting for the hash if it is still running and
+# starting it if it never did.
+#
+# Also logs the boot device and its I/O scheduler to stdout (the idle class only
+# takes effect under bfq) -- this folds in what used to be omarchy-iso-boot-medium.
+#
+# Exit 0: image verified (device/scheduler line on stdout). Non-zero: corrupt,
+# missing, or unverifiable -- the message is on stderr with the first line
+# written to headline the install dashboard.
+set -uo pipefail
+
+UNIT=omarchy-root-image-verify.service
+BOOT_MEDIUM_MOUNT=/run/archiso/bootmnt
+STREAM="$BOOT_MEDIUM_MOUNT/arch/x86_64/omarchy-root.btrfs.qcow2"
+CHECKSUM="$STREAM.sha256"
+
+fail() { echo "$1" >&2; exit 1; }
+
+# How far the hasher has read, as an integer percent: the unit's MainPID is
+# sha256sum while it runs, and its fdinfo pos on the stream is the byte
+# offset (the same source the orchestrator mirrors into the dashboard).
+# Fails silently between opens or once the unit is done; callers just skip
+# that sample.
+hash_pct() {
+  local pid fd pos size
+  pid=$(systemctl show "$UNIT" -p MainPID --value 2>/dev/null)
+  [[ $pid =~ ^[0-9]+$ && $pid -gt 0 ]] || return 1
+  size=$(stat -c %s "$STREAM" 2>/dev/null) || return 1
+  ((size > 0)) || return 1
+  for fd in /proc/"$pid"/fd/*; do
+    [[ $(readlink "$fd" 2>/dev/null) == "$STREAM" ]] || continue
+    pos=$(awk '/^pos:/ {print $2; exit}' "/proc/$pid/fdinfo/${fd##*/}" 2>/dev/null)
+    [[ -n $pos ]] && { echo $((pos * 100 / size)); return 0; }
+  done
+  return 1
+}
+
+# --- boot medium + scheduler (absorbed from omarchy-iso-boot-medium) ---
+src=$(findmnt -no SOURCE "$BOOT_MEDIUM_MOUNT" 2>/dev/null || true)
+if [[ -n $src ]]; then
+  disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
+  disk=${disk:-${src#/dev/}}
+  sched=unknown
+  [[ -r /sys/block/$disk/queue/scheduler ]] && sched=$(cat "/sys/block/$disk/queue/scheduler")
+  echo "boot medium: $src on /dev/$disk, scheduler: $sched"
+fi
+
+if [[ ! -f $STREAM ]]; then
+  # The archiso hook unmounts the boot medium after copying the airootfs to RAM
+  # (copytoram). The boot entries pin copytoram=n, so this only happens when
+  # someone edits the kernel command line.
+  [[ -d $BOOT_MEDIUM_MOUNT ]] || fail "boot medium is not mounted at $BOOT_MEDIUM_MOUNT: the live system was copied to RAM (copytoram) and the medium released; boot with copytoram=n"
+  fail "root image stream missing: $STREAM"
+fi
+[[ -f $CHECKSUM ]] || fail "root image checksum missing: $CHECKSUM"
+
+[[ "$(systemctl show "$UNIT" -p LoadState --value 2>/dev/null)" == loaded ]] ||
+  fail "$UNIT is not on this live system; cannot verify the root image"
+
+# inactive -> never started; `systemctl start` blocks until the oneshot exits.
+[[ "$(systemctl show "$UNIT" -p ActiveState --value 2>/dev/null)" == inactive ]] &&
+  systemctl start "$UNIT" >/dev/null 2>&1
+
+reported=false
+progress_drawn=false
+settling=0
+# The \r progress line needs terminating before anything else writes to the
+# terminal. Only a verified image gets the cosmetic 100%; a failure (which
+# includes a timed-out, unfinished read) just ends the line.
+finish_progress() {
+  [[ $progress_drawn == true ]] || return 0
+  [[ ${1:-} == full ]] &&
+    printf '\rverifying the install medium: 100%%' >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null
+  printf '\n' >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
+}
+while :; do
+  case "$(systemctl show "$UNIT" -p ActiveState --value 2>/dev/null)" in
+    active)
+      finish_progress full
+      exit 0
+      ;;
+    failed)
+      finish_progress
+      # Result=timeout: systemd killed the hash at the size-based
+      # TimeoutStartSec the build wrote into the unit (2 MiB/s floor over the
+      # image size). The medium is stalling reads, not returning bad data, so
+      # re-flashing the same stick is not the advice.
+      if [[ "$(systemctl show "$UNIT" -p Result --value 2>/dev/null)" == timeout ]]; then
+        fail "install medium is too slow: try another USB stick or port"$'\n'"reading the root image did not finish within its size-based timeout"
+      fi
+      # The dashboard centres each line in ~80 columns, so the action comes
+      # first and on its own line; the journal tail (the hasher's own output)
+      # follows for debugging.
+      msg="install medium is corrupt: re-flash it"$'\n'"sha256 mismatch on the root image"
+      tail=$(journalctl -b -u "$UNIT" _COMM=sha256sum --no-pager -o cat 2>/dev/null)
+      [[ -n $tail ]] && msg+=$'\n'"$tail"
+      fail "$msg"
+      ;;
+    activating)
+      if [[ $reported == false ]]; then
+        echo "waiting for $UNIT to finish hashing the root image..."
+        reported=true
+      fi
+      # Opt-in live progress for interactive callers (the free-space
+      # configurator gate): a \r-updating percent line written to the path in
+      # OMARCHY_VERIFY_PROGRESS (normally /dev/tty). Kept out of stdout, which
+      # the orchestrator logs line by line, and stderr, whose first line
+      # headlines the dashboard on failure.
+      if [[ -n ${OMARCHY_VERIFY_PROGRESS:-} ]] && pct=$(hash_pct); then
+        printf '\rverifying the install medium: %3d%%' "$pct" >>"$OMARCHY_VERIFY_PROGRESS" 2>/dev/null || true
+        progress_drawn=true
+      fi
+      sleep 0.5
+      ;;
+    deactivating)
+      # A start timeout stops the unit before it settles into failed, and the
+      # stop is what the medium makes slow: SIGTERM does not land on a read
+      # stuck in the driver. Classifying this state now would answer "did not
+      # run" for the one case the size-based TimeoutStartSec exists to name,
+      # so wait for the terminal state -- bounded past DefaultTimeoutStopSec,
+      # because a read on a dead medium may never be reaped at all.
+      if ((settling < 240)); then
+        settling=$((settling + 1))
+        sleep 0.5
+        continue
+      fi
+      finish_progress
+      fail "install medium is too slow: try another USB stick or port"$'\n'"the root image read could not be stopped after its size-based timeout"
+      ;;
+    *)
+      # systemd can briefly publish inactive between stopping the timed-out
+      # oneshot and settling it as failed. Result is already authoritative at
+      # that point; do not turn a proven timeout into the misleading "did not
+      # run" verdict merely because this poll landed in that transition.
+      if [[ "$(systemctl show "$UNIT" -p Result --value 2>/dev/null)" == timeout ]]; then
+        finish_progress
+        fail "install medium is too slow: try another USB stick or port"$'\n'"reading the root image did not finish within its size-based timeout"
+      fi
+      fail "$UNIT did not run; cannot verify the root image"
+      ;;
+  esac
+done
