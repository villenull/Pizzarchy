diff --git a/configs/syslinux/archiso_pxe-linux.cfg b/configs/syslinux/archiso_pxe-linux.cfg
index 8cf9092..b0cc919 100644
--- a/configs/syslinux/archiso_pxe-linux.cfg
+++ b/configs/syslinux/archiso_pxe-linux.cfg
@@ -1,3 +1,19 @@
+# PXE entries pin copytoram=n like every other boot entry: the root image the
+# installer streams must stay reachable under /run/archiso/bootmnt. The NBD
+# and NFS hooks would otherwise force copytoram=y (they only skip the copy
+# when the cmdline says exactly n), but both keep the server's image tree
+# mounted, so the stream is there.
+#
+# There is deliberately no HTTP entry: archiso's HTTP hook copies only the
+# airootfs (plus optional checksums) into a tmpfs and never mounts the image
+# tree, so the root image cannot exist on that path and an install from it
+# would always fail at the pre-flight gate.
+#
+# cms_verify is deliberately absent too: these ISOs are not codesigned
+# (mkarchiso is never given a certificate), and with the flag set but no
+# .cms.sig beside the airootfs the archiso hook aborts into an emergency
+# shell — every PXE boot would die there.
+
 LABEL arch64_nbd
 TEXT HELP
 Boot the Omarchy install medium using NBD.
@@ -6,7 +22,7 @@ ENDTEXT
 MENU LABEL Omarchy install medium (x86_64, NBD)
 LINUX ::/%INSTALL_DIR%/boot/x86_64/vmlinuz-linux-t2
 INITRD ::/%INSTALL_DIR%/boot/x86_64/initramfs-linux-t2.img
-APPEND archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% archiso_nbd_srv=${pxeserver} cms_verify=y initramfs_async=0
+APPEND archisobasedir=%INSTALL_DIR% archisosearchuuid=%ARCHISO_UUID% archiso_nbd_srv=${pxeserver} copytoram=n initramfs_async=0
 SYSAPPEND 3
 
 LABEL arch64_nfs
@@ -17,16 +33,5 @@ ENDTEXT
