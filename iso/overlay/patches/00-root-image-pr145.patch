--- /dev/null
+++ b/configs/airootfs/etc/systemd/system/omarchy-root-image-verify.service
@@ -0,0 +1,29 @@
+[Unit]
+Description=Verify the Omarchy root image on the install medium
+# The root image and its checksum are plain files on the ISO, which the archiso
+# initramfs mounts before pivoting, so they are there from the first unit on.
+# Starting the hash here, rather than when the install begins, hides the read
+# of a multi-GB stream behind the time the user spends in the configurator.
+# This is the only verifier: the orchestrator's prepare_install_target phase
+# collects the verdict, waits for the unit if it is still running, and fails
+# the install if it could not run.
+ConditionPathExists=/run/archiso/bootmnt/arch/x86_64/omarchy-root.btrfs.qcow2
+ConditionPathExists=/run/archiso/bootmnt/arch/x86_64/omarchy-root.btrfs.qcow2.sha256
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# TimeoutStartSec comes from a build-time drop-in sized to the image
+# (build-iso.sh writes 50-size-timeout.conf next to this unit): oneshot units
+# have no default start timeout, and a medium that stalls reads instead of
+# erroring would otherwise hang the hash, and the install waiting on it,
+# forever. On timeout Result=timeout tells the wait helper to report a slow
+# medium rather than a corrupt one.
+WorkingDirectory=/run/archiso/bootmnt/arch/x86_64
+ExecStart=/usr/bin/sha256sum --check --strict omarchy-root.btrfs.qcow2.sha256
+# Background work: never compete with the console or anything interactive.
+Nice=19
+IOSchedulingClass=idle
+
+[Install]
+WantedBy=multi-user.target
diff --git a/configs/airootfs/etc/udev/rules.d/71-omarchy-iso-boot-medium-bfq.rules b/configs/airootfs/etc/udev/rules.d/71-omarchy-iso-boot-medium-bfq.rules
new file mode 100644
index 0000000..6c97b9e
--- /dev/null
+++ b/configs/airootfs/etc/udev/rules.d/71-omarchy-iso-boot-medium-bfq.rules
@@ -0,0 +1,20 @@
+# Put the live ISO's boot medium on the BFQ I/O scheduler.
+#
+# The live system pages its airootfs in lazily from the boot medium (copytoram
+# is pinned off because the root image is streamed from the same medium), and
+# omarchy-root-image-verify.service hashes that multi-GB image from boot with
+# IOSchedulingClass=idle. Only BFQ implements I/O priority classes; under the
+# default mq-deadline the hash's sequential reads compete as equals with every
+# squashfs page-in, and on a USB 2.0 stick the boot crawls for the two minutes
+# the hash takes. With BFQ the idle-class hash yields to the live system and
+# fills the gaps instead.
+#
+# Matched wider than just the boot medium, on purpose (udev cannot know which
+# disk we booted from): every USB whole disk, including a USB install target
+# or a cidata drive; optical drives; and every mmcblk node, including internal
+# eMMC and its boot0/rpmb partitions. The consequence is only the scheduler
+# choice, and BFQ is a fine default on all of them. Internal SATA/NVMe keep
+# their default.
+# 71- so it runs after 60-persistent-storage.rules, which sets ID_BUS.
+ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_BUS}=="usb", ATTR{queue/scheduler}="bfq"
+ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sr[0-9]*|mmcblk[0-9]*", ATTR{queue/scheduler}="bfq"
