diff --git a/configs/airootfs/root/.automated_script.sh b/configs/airootfs/root/.automated_script.sh
index 16904f8..b3a0151 100644
--- a/configs/airootfs/root/.automated_script.sh
+++ b/configs/airootfs/root/.automated_script.sh
@@ -97,10 +97,73 @@
 if /usr/local/bin/omarchy-cidata-load; then
   echo "Autoinstall configuration found on cidata drive; skipping the configurator."
   export OMARCHY_UI_INTERACTIVE=no
+  # FAST-INSTALL C5/C6 (Deck slice): record that the cidata branch was taken.
+  # The block below must run ONLY here. It used to gate on
+  # /root/user_configuration.json existing, but the interactive
+  # configurator's own write_user_files writes that file too -- so on a real
+  # interactive install the cidata-only block ran, found no /root/preinstalls,
+  # and aborted the install (2026-09-24 hardware feedback). A variable set in
+  # the branch itself cannot be faked by the other path writing the same file.
+  deck_cidata_taken=yes
 else
+  deck_cidata_taken=no
   ./configurator
 fi
 
+# BEGIN deck-cidata-early-block
+# FAST-INSTALL C5/C6 (Deck slice): after a cidata load, install the
+# unattended choice files and start the early stage, then simulate the form.
+# Filenames match the harness contract and the form's live files exactly:
+# `preinstalls` + `gaming` (yes/no + newline) -> /run/omarchy-deck/choices/,
+# `form-delay-seconds` (non-negative integer) -> the simulated form length.
+# network-ready fires only for gaming=yes (the VM has user-mode networking
+# from boot); gaming=no stays fully offline. The late stage runs through the
+# dashboard below, exactly as the interactive path. Missing/invalid choice
+# files abort loudly -- installing an unanswered variant is never a default.
+# Gated on deck_cidata_taken (set in the branch above), NOT on the JSON's
+# presence: the interactive path writes user_configuration.json itself and
+# owns choices/ already, so this block must do nothing there.
+if [[ ${OMARCHY_DECK_CIDATA_EARLY:-} != 0 ]] && [[ ${deck_cidata_taken:-no} == yes ]] && [[ -f /root/user_configuration.json ]]; then
+  deck_early_disk=$(jq -r '.disk_config.device_modifications[0].device // empty' /root/user_configuration.json 2>/dev/null || true)
+  if [[ -n $deck_early_disk && -x /usr/local/bin/omarchy-deck-early ]]; then
+    mkdir -p /run/omarchy-deck/choices
+    deck_choices_ok=1
+    for deck_choice in preinstalls gaming; do
+      if [[ ! -f /root/$deck_choice ]]; then
+        echo "ERROR: cidata drive carries no '$deck_choice' file (want yes/no); refusing an unanswered variant" >&2
+        deck_choices_ok=0
+      elif ! grep -Eq '^(yes|no)$' /root/$deck_choice; then
+        echo "ERROR: cidata '$deck_choice' is not exactly 'yes' or 'no': $(head -c 40 /root/$deck_choice | tr -d '\n')" >&2
+        deck_choices_ok=0
+      else
+        cp /root/$deck_choice /run/omarchy-deck/choices/$deck_choice
+      fi
+    done
+    (( deck_choices_ok )) || exit 1
+    printf 'locked\n' > /run/omarchy-deck/choices/locked
+    if /usr/local/bin/omarchy-deck-early start "$deck_early_disk"; then
+      echo "Deck early stage started on $deck_early_disk while the form runs."
+      if [[ $(cat /run/omarchy-deck/choices/gaming) == yes ]]; then
+        /usr/local/bin/omarchy-deck-early network-ready
+      fi
+      if [[ -f /root/form-delay-seconds ]]; then
+        deck_form_delay=$(cat /root/form-delay-seconds 2>/dev/null || echo 0)
+        if [[ $deck_form_delay =~ ^[0-9]+$ ]] && (( deck_form_delay > 0 )); then
+          echo "Simulated form: sleeping ${deck_form_delay}s while the early stage runs."
+          sleep "$deck_form_delay"
+        elif [[ ! $deck_form_delay =~ ^[0-9]+$ ]]; then
+          echo "ERROR: cidata form-delay-seconds is not a non-negative integer: $deck_form_delay" >&2
+          exit 1
+        fi
+      fi
+    else
+      echo "ERROR: Deck early stage failed to start on $deck_early_disk" >&2
+      exit 1
+    fi
+  fi
+fi
+# END deck-cidata-early-block
+
 # Deferred-provisioning installs skip the celebration/reboot prompt and reboot on
 # their own — the owner completes setup at first boot. Signalled by the config's
 # defer_provisioning flag (interactive) or the defer-provisioning marker (cidata).
diff --git a/configs/airootfs/usr/local/bin/omarchy-cidata-load b/configs/airootfs/usr/local/bin/omarchy-cidata-load
index 6578849..dde86b8 100755
--- a/configs/airootfs/usr/local/bin/omarchy-cidata-load
+++ b/configs/airootfs/usr/local/bin/omarchy-cidata-load
@@ -43,7 +43,7 @@ mount -o ro "$device" "$mnt" || exit 1
 # otherwise force a fresh drive back into deferred provisioning or hand it an old
 # LUKS passphrase. The interactive wizard writes these same names, but a
 # cidata load always precedes it, so nothing of the user's is discarded here.
-optional_inputs=(user_credentials.json defer-provisioning user_full_name.txt user_email_address.txt user_encrypt_installation.txt authorized_keys tailscale_authkey)
+optional_inputs=(user_credentials.json defer-provisioning user_full_name.txt user_email_address.txt user_encrypt_installation.txt authorized_keys tailscale_authkey form-delay-seconds preinstalls gaming)
 for file in user_configuration.json "${optional_inputs[@]}"; do
   rm -f "$dest/$file"
 done
diff --git a/configs/airootfs/usr/local/bin/omarchy-install-dashboard b/configs/airootfs/usr/local/bin/omarchy-install-dashboard
index 826ab1b..f0baa29 100755
--- a/configs/airootfs/usr/local/bin/omarchy-install-dashboard
+++ b/configs/airootfs/usr/local/bin/omarchy-install-dashboard
@@ -919,8 +919,22 @@ sanitize_child_output() {
     -e '/^You may reboot when ready\.$/d'
 }
 
+# FAST-INSTALL (Deck slice): when the early stage ran (S0-A started it in the
+# interactive path, the cidata branch in .automated_script.sh in the
+# unattended path), the dashboard's child IS the late handoff: join early,
+# then run the late slice with the same configurator outputs.
+# omarchy-deck-late accepts the dashboard's original named-argument command;
+# no early state (plain full install) means the child stays untouched.
+# The original argv is forwarded intact for strict parsing.
+route_deck_late() {
+  if [[ -x /usr/local/bin/omarchy-deck-late && -f /run/omarchy-deck/early/disk ]]; then
+    INSTALL_CMD=(/usr/local/bin/omarchy-deck-late "$LOG_FILE" "${INSTALL_CMD[@]}")
+  fi
+}
+
 launch_child() {
   mkdir -p "$(dirname "$LOG_FILE")"
+  route_deck_late
   # Child is non-interactive. All visible UI belongs to this supervisor.
   PYTHONUNBUFFERED=1 setsid "${INSTALL_CMD[@]}" </dev/null > >(sanitize_child_output >>"$LOG_FILE") 2>&1 &
   child_pid=$!
diff --git a/configs/profiledef.sh b/configs/profiledef.sh
index 69567f9..7cca8bc 100644
--- a/configs/profiledef.sh
+++ b/configs/profiledef.sh
@@ -45,6 +45,8 @@ file_permissions=(
   ["/usr/local/bin/omarchy-install-dashboard"]="0:0:755"
   ["/usr/local/bin/omarchy-install-diagnose-media"]="0:0:755"
   ["/usr/local/bin/omarchy-iso-install"]="0:0:755"
+  ["/usr/local/bin/omarchy-deck-early"]="0:0:755"
+  ["/usr/local/bin/omarchy-deck-late"]="0:0:755"
   ["/usr/local/bin/omarchy-upload-log"]="0:0:755"
   ["/var/cache/omarchy/mirror/offline/"]="0:0:775"
 )
