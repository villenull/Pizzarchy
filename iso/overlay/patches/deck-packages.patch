 fi
 
+# --- Steam Deck (omarchy-deck overlay, T5-fork-plan.md §3 seam S1) ----------
+#
+# Merge the Deck's install list into the runtime's base list HERE, before the
+# shipped copy below is made, so one edit reaches all three consumers at once:
+# the offline mirror's `pacman -Syw`, the target install's
+# _runtime_package_list (which reads the shipped copy), and
+# resolve_expected_packages' denominator (which also reads the shipped copy).
+# Appending after this point desyncs them, and the denominator is the one that
+# would drift silently.
+#
+# base_pkg_lists[0] can be a read-only bind mount (/omarchy-source, under
+# --local-source), so the merged list is written to scratch and the array
+# repointed rather than edited in place.
+# $deck_list_dir is declared and checked once, up beside the seam-S4 block.
+# Both lists are read inside command substitutions further down, where an empty
+# grep would abort a subshell mid-stream and silently truncate the package set.
+# Refuse now, out loud, instead.
+for deck_list in deck-install deck-mirror; do
+  if ! grep -qv '^#\|^$' "$deck_list_dir/$deck_list.packages"; then
+    echo "ERROR: $deck_list_dir/$deck_list.packages has no package entries" >&2
+    echo "       (missing, empty, or entirely comments)." >&2
+    exit 1
+  fi
+done
+deck_merged_base=/tmp/omarchy-deck-base.packages
+{
+  cat "${base_pkg_lists[0]}"
+  echo
+  echo "# --- Steam Deck (omarchy-deck overlay) ---"
+  grep -hv '^#\|^$' "$deck_list_dir/deck-install.packages"
+} >"$deck_merged_base"
+base_pkg_lists[0]=$deck_merged_base
+
 mkdir -p "$build_cache_dir/airootfs/usr/share/omarchy-iso"
 cp "${base_pkg_lists[0]}" "$build_cache_dir/airootfs/usr/share/omarchy-iso/omarchy-base.packages"
 cp "${base_pkg_lists[1]}" "$build_cache_dir/airootfs/usr/share/omarchy-iso/omarchy-other.packages"
@@ -186,12 +336,40 @@ if [[ ! -f $setup_form ]]; then
 fi
 cp "$setup_form" "$build_cache_dir/airootfs/usr/share/omarchy-iso/setup-form.sh"
 
+# --- Steam Deck (omarchy-deck overlay) --------------------------------------
+# docs/PROGRESS.md §3.8: with no AMD provider named, pacman satisfies steam's
+# virtual vulkan-driver/lib32-vulkan-driver with the NVIDIA stack and nothing
+# errors. Ask before the ~6 GB download below, so a wrong package set costs
+# seconds rather than a full mirror. The script documents how it proves it was
+# looking rather than merely exiting 0.
+#
+# CONSUMER 2 of deck_local_packages: the resolve above is against the ONLINE
+# repositories, and our own packages exist in none of them -- `pacman -S
+# --print` aborts the WHOLE transaction on one unresolvable target, so leaving
+# them in would kill the build here. The guard is told which names to exclude
+# rather than being taught to tolerate failure: it still asserts each excluded
+# name IS in deck-install.packages, and that excluding it actually removed
+# something from the target list.
+DECK_LOCAL_PACKAGES="${deck_local_packages[*]}" \
+  bash "$deck_list_dir/deck-nvidia-dry-run.sh" \
+  "/configs/pacman-online-${OMARCHY_MIRROR}.conf" \
+  "$build_cache_dir/airootfs/usr/share/omarchy-iso/omarchy-base.packages" \
+  /builder/archinstall.packages \
+  "$deck_list_dir" \
+  "$OMARCHY_RUNTIME_PACKAGE" "$OMARCHY_SETTINGS_PACKAGE" "$OMARCHY_NVIM_PACKAGE"
+
 # Collect every package we want available in the offline mirror.
 declare -a all_packages
 mapfile -t all_packages < <(
   {
     cat "$build_cache_dir/packages.x86_64"
     grep -hv '^#\|^$' "${base_pkg_lists[@]}"
+    # Steam Deck packages carried in the offline mirror but NOT installed by
+    # pacstrap -- the omarchy-deck package pulls them out of the mirror at
+    # install time. Deliberately not merged into omarchy-base.packages above:
+    # entries here may be repo-qualified (jupiter-staging/gamescope), and that
+    # aborts the single-repo offline resolve both this build and pacstrap do.
+    grep -hv '^#\|^$' "$deck_list_dir/deck-mirror.packages"
     grep -hv '^#\|^$' /builder/archinstall.packages
     # Always include the selected Omarchy packages so the target install can
     # find the runtime and companion packages in the offline mirror.
@@ -212,6 +390,28 @@ if [[ -n ${LOCAL_OMARCHY_BUILD:-} ]]; then
   )
 fi
 
+# CONSUMER 3 of deck_local_packages (T5-fork-plan.md §3 seam S4): the same
+# treatment, but UNCONDITIONAL -- unlike upstream's three, ours are always
+# locally built and exist in no online repository at all. They reach
+# all_packages through deck-install.packages (merged into base_pkg_lists[0]
+# above), and leaving them in makes the ~6 GB `pacman -Syw` below abort with
+# "target not found" after the download rather than before it.
+deck_strip_args=()
+for deck_pkg in "${deck_local_packages[@]}"; do
+  deck_strip_args+=(-e "$deck_pkg")
+done
+mapfile -t all_packages < <(
+  printf '%s\n' "${all_packages[@]}" | grep -Fxv "${deck_strip_args[@]}" || true
+)
+# grep -Fxv exits 1 when it prints nothing and 2 on a real error, and `|| true`
+# cannot tell them apart. The emptiness check makes the distinction instead:
+# a mirror target list of nothing is never correct.
+if ((${#all_packages[@]} == 0)); then
+  echo "ERROR: stripping the locally built Deck packages emptied the offline" >&2
+  echo "       mirror target list (${deck_local_packages[*]})." >&2
+  exit 1
+fi
+
 mkdir -p /tmp/offlinedb
 download_offline_packages() {
   pacman --config /configs/pacman-online-${OMARCHY_MIRROR}.conf --noconfirm -Syw \
@@ -265,6 +465,36 @@ if [[ -n ${LOCAL_OMARCHY_BUILD:-} ]]; then
   done
 fi
 
+# CONSUMER 4 of deck_local_packages (T5-fork-plan.md §3 seam S4). Same reason
+# as the block above, same verification (exactly one artifact per name, its
+# identity read out of the archive with `pacman -Qp` rather than guessed from
+# the filename), but again unconditional.
+#
+# 🔴 Without this, prune-offline-mirror.sh DELETES our package: the online
+# transaction that produced required_package_files never selected it, because
+# it is in no online repo. Nothing errors at build time; the install fails at
+# pacstrap, on a target the mirror no longer carries.
+for deck_pkg in "${deck_local_packages[@]}"; do
+  deck_pkg_file=""
+  for candidate in "$offline_mirror_dir/$deck_pkg-"*.pkg.tar.*; do
+    [[ -f $candidate && $candidate != *.sig ]] || continue
+    read -r candidate_name _ < <(pacman -Qp "$candidate" 2>/dev/null) || continue
+    [[ $candidate_name == "$deck_pkg" ]] || continue
+    if [[ -n $deck_pkg_file ]]; then
+      echo "ERROR: multiple local builds found for $deck_pkg in $offline_mirror_dir" >&2
+      exit 1
+    fi
+    deck_pkg_file="${candidate##*/}"
+  done
+  if [[ -z $deck_pkg_file ]]; then
+    echo "ERROR: the locally built $deck_pkg is not in $offline_mirror_dir" >&2
+    echo "       It was built above, so it was pruned, moved, or never placed." >&2
+    echo "       Continuing would ship a mirror pacstrap cannot install from." >&2
+    exit 1
+  fi
+  required_package_files+=("$deck_pkg_file")
+done
+
 printf '%s\n' "${required_package_files[@]}" |
   bash /builder/prune-offline-mirror.sh "$offline_mirror_dir"
 
