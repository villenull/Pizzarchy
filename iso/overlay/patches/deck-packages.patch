+deck_pkgbuild_dir="$deck_list_dir/pkgbuilds"
+if [[ ! -d $deck_pkgbuild_dir ]]; then
+  echo "ERROR: $deck_pkgbuild_dir is missing from the ISO configs." >&2
+  echo "       This directory IS the declaration of which packages we build" >&2
+  echo "       ourselves; an absent one would silently produce an ISO with no" >&2
+  echo "       Deck package on the target at all." >&2
+  exit 1
+fi
+
+# The directory listing is the single declaration. A stray directory without a
+# PKGBUILD is an error rather than a skipped entry -- a name that quietly drops
+# out here drops out of all four consumers at once, which is exactly the
+# silent-desync failure this block exists to make impossible.
+deck_local_packages=()
+for deck_pkgbuild_path in "$deck_pkgbuild_dir"/*/; do
+  [[ -d $deck_pkgbuild_path ]] || continue
+  deck_pkg_name=$(basename "$deck_pkgbuild_path")
+  if [[ ! -f "$deck_pkgbuild_path/PKGBUILD" ]]; then
+    echo "ERROR: $deck_pkgbuild_dir/$deck_pkg_name has no PKGBUILD." >&2
+    echo "       Every directory here names a package this build must produce." >&2
+    exit 1
+  fi
+  deck_local_packages+=("$deck_pkg_name")
+done
