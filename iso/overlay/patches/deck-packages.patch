+# ===========================================================================
+# Steam Deck (omarchy-deck overlay, T5-fork-plan.md §3 seam S4)
+#
+# 🔴 ONE LIST, FOUR CONSUMERS. `deck_local_packages` is declared exactly once,
+# right here, and is derived from the directory that actually builds them --
+# not hand-written a second time. Every consumer below reads this one array:
+#
+#   1. this block          -- makepkg builds them straight into the mirror
+#   2. deck-nvidia-dry-run -- excludes them from its ONLINE resolve
+#   3. the `pacman -Syw`   -- strips them from the online download list
+#   4. the prune keep-set  -- adds them back, or they are deleted again
+#
+# A desync between any two of them is SILENT: the package builds, the mirror
+# is pruned, and the failure surfaces at pacstrap on the target. This is the
+# same lesson seam S1 already encodes one screen further down.
+# ===========================================================================
+
+deck_list_dir=/configs/deck
+if [[ ! -d $deck_list_dir ]]; then
+  echo "ERROR: $deck_list_dir is missing from the ISO configs." >&2
+  echo "       The omarchy-deck overlay's package lists live there; without them" >&2
+  echo "       this build would quietly produce a stock Omarchy ISO instead." >&2
+  exit 1
+fi
+
+# ===========================================================================
+# 🔴 EVERY DECK PACKAGE LIST MUST NAME A CONSUMER THAT INSTALLS IT.
+#
+# docs/findings/P32-steam-never-installed.md: `deck-fetch.packages` was
+# written, commented, maintained, unit-tested, read by a build guard -- and
+# read by NOTHING THAT INSTALLS ANYTHING. The shipped ISO produced a Deck with
+# no Steam, a black screen, and eleven green install steps saying otherwise.
+# `deck-mirror.packages` carried the same defect ("installed later", by nobody)
+# and cost the Neptune kernel and the audio DSP firmware.
+#
+# The general fix is this manifest: the set of lists that EXIST and the set of
+# lists something READS are declared once and checked BOTH WAYS. A new list
+# added without a consumer fails the build here instead of shipping as a
+# comment; a consumer whose list was deleted or renamed fails here too.
+#
+#   deck-install.packages  merged into omarchy-base.packages by seam S1 below;
+#                          pacstrap installs every entry onto the TARGET,
+#                          resolved against the offline mirror
+#   deck-mirror.packages   added to `all_packages` below; `pacman -Syw` puts
+#                          every entry in the OFFLINE MIRROR and the prune
+#                          keep-set holds it. Entries here that must also be
+#                          installed appear a second time, bare, in
+#                          deck-install.packages (the dual-entry pattern)
+#   deck-live.packages     appended to packages.x86_64 by seam S6 below;
+#                          mkarchiso installs every entry into the LIVE root
+#   deck-fetch.packages    copied into the live ISO below as
+#                          /usr/share/omarchy-iso/deck-fetch.packages and read
+#                          at INSTALL time by the orchestrator's deck_pkgs.py,
+#                          which installs every entry into the target over the
+#                          network. Also read at build time by
+#                          deck-nvidia-dry-run.sh, which only ASKS about it --
+#                          that is the reader that was mistaken for a consumer.
+#
+# ⚠️ This checks that a consumer is DECLARED, which is not the same as proving
+# one runs. The per-list emptiness refusals further down and
+# test/unit/test-deck-pkgs.py are the other half; nothing here can notice a
+# consumer that was deleted from the orchestrator.
+deck_known_lists=(deck-install deck-mirror deck-live deck-fetch)
+
+for deck_list in "${deck_known_lists[@]}"; do
+  if [[ ! -f "$deck_list_dir/$deck_list.packages" ]]; then
+    echo "ERROR: $deck_list_dir/$deck_list.packages is declared in this build's" >&2
+    echo "       consumer manifest but does not exist." >&2
+    echo "       Something below reads it. A missing file would make that reader" >&2
+    echo "       install nothing, silently, on the target -- which is exactly the" >&2
+    echo "       P3.2 defect (docs/findings/P32-steam-never-installed.md)." >&2
+    exit 1
+  fi
+done
+
+# The other direction, and the one that catches a NEW list: a *.packages file
+# in this directory that the manifest does not name is a list no consumer
+# reads. Refuse rather than ignore -- an ignored file is indistinguishable from
+# a working one right up until a Deck boots without what it promised.
+shopt -s nullglob
+for deck_list_path in "$deck_list_dir"/*.packages; do
+  deck_list_name=$(basename "$deck_list_path" .packages)
+  deck_list_known=0
+  # ⚠️ `if`, not `[[ ... ]] && x=y`: this script runs under `set -e`, and an
+  # && list whose last command is the FAILING test terminates the build. The
+  # same trap is documented in the Deck's first-boot scripts.
+  for deck_known in "${deck_known_lists[@]}"; do
+    if [[ $deck_list_name == "$deck_known" ]]; then
+      deck_list_known=1
+      break
+    fi
+  done
+  # ⚠️ `[[ $deck_list_known == 0 ]]`, not `((deck_list_known == 0))`. The
+  # arithmetic form names the variable straight after a `(`, which is command
+  # position to test/unit/test-iso-build.sh's patch-dependency scanner -- it
+  # then reports this patch as calling a shell function `deck_list_known` that
+  # nothing defines, and fails the build for a bug that does not exist.
+  if [[ $deck_list_known == 0 ]]; then
+    echo "ERROR: $deck_list_path has no consumer." >&2
+    echo "       Every Steam Deck package list must be named in deck_known_lists" >&2
+    echo "       in builder/build-iso.sh (iso/overlay/patches/deck-packages.patch)" >&2
+    echo "       AND be read by something that installs it. A list nobody reads is" >&2
+    echo "       a comment that looks like configuration; that is how the shipped" >&2
+    echo "       ISO came to have no Steam." >&2
+    exit 1
+  fi
+done
+shopt -u nullglob
+# ===========================================================================
