+  echo "ERROR: $deck_pkgbuild_dir contains no package directories." >&2
+  echo "       Nothing would be built, the target would get no omarchy-deck" >&2
+  echo "       package, and every check below would pass over an empty set." >&2
+  exit 1
+fi
+echo "Steam Deck: building ${#deck_local_packages[@]} local package(s): ${deck_local_packages[*]}"
+
+# CONSUMER 1: build them into the offline mirror.
+#
+# They cannot go through /builder/build-omarchy-packages.sh -- that script
+# lives in the upstream tree and reads /omarchy-pkgs. The mechanics below are
+# deliberately its mechanics: makepkg refuses to run as root, /configs is a
+# read-only bind mount, so the recipe is copied to a writable work dir, chowned
+# and built under `su builder` with PKGDEST set.
+#
+# The builder user may or may not exist already: build-omarchy-packages.sh
+# creates it, and it only runs under --local-source. Handle both, loudly.
+deck_pkg_work=/tmp/omarchy-deck-pkg-build
+rm -rf "$deck_pkg_work"
+mkdir -p "$deck_pkg_work"
+if id builder &>/dev/null; then
+  echo "Steam Deck: reusing the existing 'builder' user"
+else
+  echo "Steam Deck: creating the 'builder' user (build-omarchy-packages.sh did not run)"
+  useradd -m -s /bin/bash builder
+fi
+chown builder:builder "$deck_pkg_work"
+
+for deck_pkg in "${deck_local_packages[@]}"; do
+  echo "----------------------------------------"
+  echo "Building $deck_pkg (omarchy-deck overlay)"
+  echo "----------------------------------------"
+  # The offline mirror is a PERSISTENT bind mount across builds (iso/bin/build
+  # guard 6.3), so a previous run's artifact survives here. Left in place, a
+  # pkgver bump would leave two files for one name and the keep-set check below
+  # would refuse the build. Every local package is rebuilt in this same loop, so
+  # clearing a sibling's file by prefix is harmless.
+  rm -f "$offline_mirror_dir/$deck_pkg-"*.pkg.tar.*
+
+  deck_pkg_work_dir="$deck_pkg_work/$deck_pkg"
+  cp -a "$deck_pkgbuild_dir/$deck_pkg" "$deck_pkg_work_dir"
+  chown -R builder:builder "$deck_pkg_work_dir"
+  su builder -c "
+    cd '$deck_pkg_work_dir' &&
+    PKGDEST='$deck_pkg_work' \
+    makepkg --noconfirm --skippgpcheck --skipchecksums --nodeps -f
+  "
+done
+
+shopt -s nullglob
+deck_built_files=("$deck_pkg_work"/*.pkg.tar.zst)
+shopt -u nullglob
+if ((${#deck_built_files[@]} < ${#deck_local_packages[@]})); then
+  echo "ERROR: makepkg produced ${#deck_built_files[@]} archive(s) for ${#deck_local_packages[@]} package(s)." >&2
+  echo "       A recipe built without producing a package would be pruned out of" >&2
+  echo "       the mirror and fail pacstrap on the target instead of here." >&2
+  exit 1
+fi
+for deck_built_file in "${deck_built_files[@]}"; do
+  deck_destination="$offline_mirror_dir/$(basename "$deck_built_file")"
+  # A cached signature belongs to whatever was there before; pacman rejects an
+  # otherwise valid local build sitting beside a stale .sig.
+  rm -f "$deck_destination" "$deck_destination.sig"
+  mv "$deck_built_file" "$deck_destination"
+  echo "Steam Deck: placed $(basename "$deck_destination") in the offline mirror"
+done
+
